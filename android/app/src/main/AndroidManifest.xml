<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="one.levvs.sora.legacy">

    <uses-sdk
        android:minSdkVersion="21"
        android:targetSdkVersion="34" />

    <!-- Minimal permission set; each entry is used by named code:
         INTERNET               subscription fetch + engine sockets
         ACCESS_NETWORK_STATE   default-interface monitor / getInterfaces
         ACCESS_WIFI_STATE      libbox ReadWIFIState (SSID/BSSID)
         FOREGROUND_SERVICE(+_SPECIAL_USE)
                                startForeground from the VpnService on API 34
         POST_NOTIFICATIONS     runtime-requested on API 33+ only -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:allowBackup="false"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ServersActivity"
            android:exported="false"
            android:label="@string/servers_title" />

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title" />

        <!-- API 34 has no dedicated "vpn" foreground-service type; a
             user-started VpnService is the textbook specialUse case.
             The subtype property is required by API 34 policy for
             FOREGROUND_SERVICE_SPECIAL_USE. -->
        <service
            android:name=".SoraVpnService"
            android:exported="false"
            android:foregroundServiceType="specialUse"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-started VPN tunnel (Sora Legacy)" />
        </service>
    </application>
</manifest>
