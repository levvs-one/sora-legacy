<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDisplayName</key>
	<string>Sora Legacy</string>
	<key>CFBundleName</key>
	<string>SoraLegacy</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleShortVersionString</key>
	<string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key>
	<string>$(CURRENT_PROJECT_VERSION)</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<!-- No UILaunchStoryboardName: there is no storyboard in this
	     tree — AppDelegate builds the window in code. The key was
	     previously present with an empty string, which is not the
	     same as absent; removed rather than faked. -->
	<key>NSAppTransportSecurity</key>
	<dict>
		<!-- Subscriptions are fetched from user-supplied URLs only;
		     no blanket ATS exception: providers must serve https. -->
		<key>NSAllowsArbitraryLoads</key>
		<false/>
	</dict>
</dict>
</plist>
